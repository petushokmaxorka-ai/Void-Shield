{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./out/test-src",
    "rootDir": "./src",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "src/main/subscription.ts",
    "src/main/config-builder.ts",
    "src/main/xray-constants.ts",
    "src/main/singbox-config-builder.ts",
    "src/main/routing-scenarios.ts",
    "src/shared/node-region.ts",
    "src/shared/ru-civic-domains.ts"
  ]
}
